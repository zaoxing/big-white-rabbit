# Build
build/
dist/
*.egg-info/
_skbuild/
*.so
*.dylib
*.metallib

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Calibration profiles / caches (machine-specific, see placement/calibrate.py)
.freetoken-mac/
*.calib.json

# Models
*.gguf
# MLX weights (large, machine-local; FTM_MLX_MODEL points here)
*.safetensors
# Everything under models/ except the checked-in recipes. This used to name
# each model directory one at a time, which was already stale -- and the
# downloader now writes new ones here on its own (server/downloads.py), so a
# downloaded model would have shown up as several GB of untracked files.
# `.bwr/` in the same directory is the server's profile store.
models/*
!models/recipes/

# macOS
.DS_Store

# loop-eng working state (contract, evidence logs, round history)
.loop/

# Agent coding specs — keep locally for dev, not on GitHub (user request 2026-09-11)
SPEC-*.md
docs/

# Loop working files — local only (same policy as agent specs)
loop-constraints.md
loop-budget.md
STATE.md
loop-run-log.md

# mtplx CLI run artifacts (tune logs/receipts)
outputs/


# macOS bundle Python layers (venvstacks). _export alone is ~525 MB; all
# three are reproducible from packaging/venvstacks.toml + build.py.
packaging/_export/
packaging/_build/
packaging/_artifacts/
